# Each app is its own git repo; only the port inventory and the sample app are tracked here
Apps/*
!Apps/PORTS.md
!Apps/AGENTS.md
!Apps/sample-app/

# Screenshots and downloads stay local until inbox-processing files them
Inbox/*
!Inbox/.gitkeep
!Inbox/AGENTS.md

# Local-only agent settings
.claude/settings.local.json

# Obsidian UI state, rewritten on every open
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Secrets and credentials
.env
.env.*
*.pem
*.key

# Python bytecode
__pycache__/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
